{
  "name": "jevusecases",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "predev": "node scripts/generate-projects-data.ts",
    "dev": "next dev",
    "prebuild": "node scripts/generate-projects-data.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node --env-file=.env.local scripts/setup-db.ts",
    "admin:invite": "node --env-file=.env.local scripts/invite.ts",
    "visitor:records": "node --env-file=.env.local scripts/visitor-records.ts",
    "globe:data": "node scripts/generate-globe-data.ts",
    "pretest": "node scripts/generate-projects-data.ts",
    "test": "vitest run",
    "cf:build": "node scripts/build-cloudflare-static.ts",
    "cf:preview": "wrangler dev",
    "cf:deploy:preview": "wrangler deploy",
    "cf:deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "db:migrate:preview": "wrangler d1 migrations apply jevusecases-preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply jevusecases-production --remote --config wrangler.production.jsonc",
    "admin:d1": "node scripts/d1-admin.ts",
    "cf:compatibility": "wrangler dev --config wrangler.compatibility.jsonc --port 8790"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "1.20.9",
    "@vercel/functions": "^3.9.8",
    "d3-geo": "^3.1.1",
    "jose": "^6.1.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "miniflare": "^5.20261006.0-alpha",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1",
    "world-countries": "^5.1.0",
    "wrangler": "4.148.0"
  }
}
